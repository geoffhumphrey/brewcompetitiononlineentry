parameters:
    level: 0
    parallel:
        maximumNumberOfProcesses: 2
        processTimeout: 1800.0
    paths:
        - lib/
        - includes/
        - admin/
        - pub/
        - sections/
        - output/
        - eval/
        - ajax/
        - setup/
        - update/
        - site/
        - .
        - index.php
        - index.legacy.php
        - index.pub.php
        - handle.php
        - qr.php
        - setup.php
        - update.php
        - awards.php
        - maintenance.php
        - ppv.php
        - paths.php
    excludePaths:
        - var/
        - vendor/
        - tests/
        - .git/
        - node_modules/
        - classes/
        - site/MysqliDb.php
        - site/dbObject.php
        - site/bootstrap.php
    tmpDir: var/phpstan
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            identifier: missingType.generics

includes:
    - phpstan-baseline.neon
